# Public YouTube Data API access used by the dashboard.
YOUTUBE_API_KEY=replace_with_a_restricted_key

# Gemini access used for classification and sentiment analysis.
GEMINI_API_KEY=replace_with_a_restricted_key
GEMINI_MODEL=gemini-2.0-flash

# Download this OAuth file from Google Cloud Console. The secrets/ directory is
# intentionally ignored by Git.
GOOGLE_CLIENT_SECRETS_FILE=secrets/client_secret.json
OAUTH_LOCAL_PORT=8080

# Keep disabled until the classifier output has been reviewed on your channel.
ENABLE_AUTO_MODERATION=false

# Web server settings.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
